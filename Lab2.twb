      <aliases enabled='yes' />
      <column datatype='integer' hidden='true' name='[Beds]' role='measure' type='quantitative' />
      <column caption='Review performance score' datatype='integer' name='[Calculation_0092133974863872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Properties by Category' datatype='string' name='[Calculation_0092133977591809]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; 300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price] &gt;= 150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Customer review' datatype='string' name='[Calculation_0092133978509314]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt; 100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Less Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Availability status ' datatype='string' name='[Calculation_0092133980135427]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= DATE(&quot;2009-01-01&quot;) THEN &quot;Active Host&quot; &#13;&#10;ELSE &quot;New Host&quot; &#13;&#10;END' />
      </column>
      <column caption='Pricing by Beds' datatype='integer' name='[Calculation_0092133981339652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Price]*[Beds]' />
      </column>
      <column caption='RSR Status' datatype='string' name='[Calculation_0092133982576645]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Review Scores Rating] &gt; 90 THEN &quot;Excellent&quot;&#13;&#10;ELSEIF [Review Scores Rating] &gt;= 80 THEN &quot;Good&quot;&#13;&#10;ELSEIF [Review Scores Rating] &gt;= 70 THEN &quot;Average&quot;&#13;&#10;ELSE &quot;Poor&quot;&#13;&#10;END' />
      </column>
      <column caption='Property Category' datatype='string' name='[Calculation_0092133983752199]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; 400 THEN &quot;Expensive&quot;&#13;&#10;ELSE &quot;Normal&quot;&#13;&#10;END' />
      </column>
      <column caption='Price filter Category' datatype='string' name='[Calculation_0092133988323337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0092133987758088] THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Host_Since_N' datatype='datetime' name='[Calculation_0811491935023104]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since], DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Updated_Neighbourhood' datatype='string' name='[Calculation_0811491935555585]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Neighbourhood], &quot;UNknown&quot;)' />
      </column>
      <column caption='Review_Score_Rating_(Bin)' datatype='string' name='[Calculation_0811491939119106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating]), &quot;Not Rated&quot;)' />
      </column>
      <column caption='Updated_Beds' datatype='integer' name='[Calculation_0811491941834755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Beds],0)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='datetime' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column datatype='string' hidden='true' name='[Neighbourhood]' role='dimension' type='nominal' />
      <column datatype='string' name='[Property Type]' role='dimension' type='nominal' />
      <column datatype='integer' hidden='true' name='[Review Scores Rating]' role='measure' type='quantitative' />
      <column caption='Room Category' datatype='string' name='[Room Type (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Room Type]' new-bin='true'>
          <bin default-name='false' value='&quot;Budget stay&quot;'>
            <value>&quot;Private room&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Premium stay&quot;'>
            <value>&quot;Entire home/apt&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Shared Accomodation&quot;'>
            <value>&quot;Shared room&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Room Type]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column caption='Airbnb_listings.csv' datatype='table' name='[__tableau_internal_object_id__].[Airbnb_listings - Airbnb_listings.csv_13CE9BBB1A7448528121E87243B296A0]' role='measure' type='quantitative' />
      <group caption='Residential Properties' name='[Residential Properties]' name-style='unqualified' user:ui-builder='filter-group'>
        <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[Property Type]' member='&quot;Apartment&quot;' />
          <groupfilter function='member' level='[Property Type]' member='&quot;House&quot;' />
